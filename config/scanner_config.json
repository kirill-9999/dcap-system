// config/scanner_config.json
{
    "scanner": {
        "name": "scanner-1",
        "manager_endpoint": "localhost:50051",
        "state_dir": "scanner_state"
    },
    "performance": {
        "max_file_size_mb": 50,
        "cache_cleanup_interval": 500,
        "models_reload_after_files": 3000,
        "memory_limit_rss_mb": 8192,
        "emergency_restart_threshold": 85,
        "save_interval": 500,
        "catalog_save_interval": 500
    },
    "classifiers": {
        "pii_classifier": {
            "enabled": true,
            "ocr_enabled": true,
            "min_confidence": 0.5
        },
        "credentials_classifier": {"enabled": true},
        "code_classifier": {"enabled": true}
    },
    "logging": {
        "level": "INFO"
    }
}