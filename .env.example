# DCAP System вЂ” РїРµСЂРµРјРµРЅРЅС‹Рµ РѕРєСЂСѓР¶РµРЅРёСЏ
# РЎРєРѕРїРёСЂСѓР№С‚Рµ РІ .env (РµСЃР»Рё РЅСѓР¶РЅРѕ РїРµСЂРµРѕРїСЂРµРґРµР»РёС‚СЊ) РёР»Рё СѓСЃС‚Р°РЅРѕРІРёС‚Рµ РІ СЃРёСЃС‚РµРјРµ.

# ===== Р’Р•Р РЎРРЇ РћР‘Р РђР—РћР’ =====
VERSION=3.13.24

# ===== РџРћР РўР« =====
MANAGER_PORT=8000
WEBUI_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
FLOWER_PORT=5555
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
PG_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
CELERY_EXPORTER_PORT=9808

# ===== РђСѓС‚РµРЅС‚РёС„РёРєР°С†РёСЏ =====
# Р РµР¶РёРј: local (JWT+Bcrypt) | hybrid (SPNEGO -> local) | windows_integrated (SPNEGO)
AUTH_MODE=local

# РЎРµРєСЂРµС‚РЅС‹Р№ РєР»СЋС‡ JWT (РѕР±СЏР·Р°С‚РµР»СЊРЅРѕ СЃРјРµРЅРёС‚СЊ РІ production!)
JWT_SECRET_KEY=change-me-in-production

# TTL токенов (BUG-038: env-плейсхолдеры вместо захардкоженных значений в config.json)
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=7

# ===== Key Findings (TASK-018: только ENV, обязательны для production) =====
# Генерация: python scripts/generate_findings_keys.py --output ./secrets/
FINDINGS_ENCRYPTION_KEY=<base64 32 bytes>
FINDINGS_HMAC_KEY=<base64 32 bytes>
FINDINGS_KEY_ID=key-2026-09

# Secure-флаг HttpOnly cookie (BUG-042): true только за HTTPS
AUTH_COOKIE_SECURE=false

# ===== Active Directory (РґР»СЏ hybrid/windows_integrated) =====
AD_DOMAIN=
AD_SERVER=
AD_SERVICE_USER=
AD_SERVICE_PASSWORD=

# ===== PostgreSQL =====
POSTGRES_DB=dcap
POSTGRES_USER=dcap
POSTGRES_PASSWORD=dcap123

# ===== Redis (Celery broker + РєСЌС€ + rate-limit) =====
REDIS_PASSWORD=redis123
REDIS_ENABLED=true

# ===== Celery =====
CELERY_WORKER_QUEUES=audit_events,scanner_tasks,retention,reports

# ===== S3/MinIO Р°СѓРґРёС‚-Р°РіРµРЅС‚ (profile agents) =====
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=dcap-logs
S3_ACCESS_KEY=
S3_SECRET_KEY=
# mTLS РґР»СЏ s3-Р°РіРµРЅС‚Р° (РїСѓС‚Рё РІРЅСѓС‚СЂРё РєРѕРЅС‚РµР№РЅРµСЂР°)
# MTLS_CERT_PATH=
# MTLS_KEY_PATH=
# MTLS_CA_PATH=

# ===== РњРћРќРРўРћР РРќР“ (Р”РµРЅСЊ 39) =====
# Grafana: http://localhost:3000 (admin / ${GRAFANA_PASSWORD})
GRAFANA_PASSWORD=admin
# Alertmanager (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ: webhook/email/slack/telegram СЃРј. monitoring/alertmanager/alertmanager.yml)
ALERTMANAGER_ENABLED=true

# ===== SCANNER (РќР• РІ Docker, РЅР° С…РѕСЃС‚Рµ) =====
# РЎРєР°РЅРµСЂ Р·Р°РїСѓСЃРєР°РµС‚СЃСЏ РЅР° С…РѕСЃС‚Рµ: python run_scanner.py scanner/config/scanner_config.json
# РћРЅ РІРёРґРёС‚ РІСЃРµ РїСѓС‚Рё С…РѕСЃС‚Р°, РїРѕСЌС‚РѕРјСѓ РќР• С‚СЂРµР±СѓРµС‚ РјРѕРЅС‚РёСЂРѕРІР°РЅРёСЏ РІ РєРѕРЅС‚РµР№РЅРµСЂ.
# MANAGER_URL (http://localhost:8000) Р·Р°РґР°С‘С‚СЃСЏ РІ scanner/config/scanner_config.json

# ===== mTLS (Р”РµРЅСЊ 34) =====
MTLS_ENABLED=false
MTLS_STRICT=false
CERTS_DIR=certs


# ===== FINDINGS ENCRYPTION (v3.13.11, TASK-018) =====
# Keys are ENV-only; Docker Secrets are removed. Set the keys in the
"Key Findings" section above (FINDINGS_ENCRYPTION_KEY / FINDINGS_HMAC_KEY).
FINDINGS_KEY_ID=key-2026-09
# BUG-057: БЕЗ ключей сканер не стартует (fail-fast). Legacy (plaintext) —
# только для разработки, открывается этим флагом:
# DCAP_ALLOW_LEGACY_SCANNER=true

# ===== Р›РѕРіРёСЂРѕРІР°РЅРёРµ =====
LOG_LEVEL=INFO

# ===== HTTP (utf-8 РґР»СЏ РєРѕРЅСЃРѕР»Рё Windows) =====
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# ===== BACKLOG-086 (v3.13.19): EMBEDDED OCR FRAGMENTS =====
# Scanner embeds OCR PNG fragments (<= MAX_FRAGMENT_EMBED_SIZE) into findings.
MAX_FRAGMENT_EMBED_SIZE=2097152
# Scanner batches results POST by size (20 MB default).
MAX_BATCH_SIZE_BYTES=20971520
