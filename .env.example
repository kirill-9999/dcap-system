# DCAP System — переменные окружения
# Скопируйте в .env (если нужно переопределить) или установите в системе.

# ===== ВЕРСИЯ ОБРАЗОВ =====
VERSION=3.5.0

# ===== ПОРТЫ =====
MANAGER_PORT=8000
WEBUI_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
FLOWER_PORT=5555

# ===== Аутентификация =====
# Режим: local (JWT+Bcrypt) | hybrid (SPNEGO -> local) | windows_integrated (SPNEGO)
AUTH_MODE=local

# Секретный ключ JWT (обязательно сменить в production!)
JWT_SECRET_KEY=change-me-in-production

# ===== Active Directory (для hybrid/windows_integrated) =====
AD_DOMAIN=
AD_SERVER=
AD_SERVICE_USER=
AD_SERVICE_PASSWORD=

# ===== PostgreSQL =====
POSTGRES_DB=dcap
POSTGRES_USER=dcap
POSTGRES_PASSWORD=dcap123

# ===== Redis (Celery broker + кэш + rate-limit) =====
REDIS_PASSWORD=redis123
REDIS_ENABLED=true

# ===== Celery =====
CELERY_WORKER_QUEUES=audit_events,scanner_tasks,retention,reports

# ===== S3/MinIO аудит-агент (profile agents) =====
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=dcap-logs
S3_ACCESS_KEY=
S3_SECRET_KEY=
# mTLS для s3-агента (пути внутри контейнера)
# MTLS_CERT_PATH=
# MTLS_KEY_PATH=
# MTLS_CA_PATH=

# ===== mTLS (День 34) =====
MTLS_ENABLED=false
MTLS_STRICT=false
CERTS_DIR=certs

# ===== Логирование =====
LOG_LEVEL=INFO

# ===== HTTP (utf-8 для консоли Windows) =====
PYTHONUTF8=1
PYTHONIOENCODING=utf-8