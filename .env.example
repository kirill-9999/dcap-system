# DCAP System — переменные окружения
# Скопируйте в .env (если нужно переопределить) или установите в системе.

# ===== Аутентификация =====
# Режим: local (JWT+Bcrypt) | hybrid (SPNEGO -> local) | windows_integrated (SPNEGO)
AUTH_MODE=local

# Секретный ключ JWT (обязательно сменить в production!)
JWT_SECRET_KEY=change-me-in-production-32-chars-long

# ===== Active Directory (для hybrid/windows_integrated) =====
AD_DOMAIN=
AD_SERVER=
AD_SERVICE_USER=
AD_SERVICE_PASSWORD=

# ===== База данных =====
# Локальный запуск (default): postgres (production) или sqlite (development)
# DATABASE_URL=postgresql://dcap:dcap123@localhost:5432/dcap
# DATABASE_URL=sqlite:///manager/dcap.db
DB_PASSWORD=dcap123

# ===== Redis (День 36-37: Celery broker + кэш + rate-limit) =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis123
REDIS_ENABLED=true

# ===== Celery =====
# Брокер формируется из REDIS_URL + REDIS_PASSWORD (см. workers/celery_app.py)
CELERY_WORKER_QUEUES=audit_events,scanner_tasks,retention,reports

# ===== mTLS (День 34) =====
# MTLS_ENABLED=true
# MTLS_STRICT=false
# CERTS_DIR=certs

# ===== HTTP (utf-8 для консоли Windows) =====
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
