# DCAP System — переменные окружения
# Скопируйте в .env (если нужно переопределить) или установите в системе.

# ===== ВЕРСИЯ ОБРАЗОВ =====
VERSION=3.0.0

# ===== ПОРТЫ =====
MANAGER_PORT=8000
WEBUI_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
FLOWER_PORT=5555
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
PG_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
CELERY_EXPORTER_PORT=9808

# ===== Аутентификация =====
# Режим: local (JWT+Bcrypt) | hybrid (SPNEGO -> local) | windows_integrated (SPNEGO)
AUTH_MODE=local

# Секретный ключ JWT (обязательно сменить в production!)
JWT_SECRET_KEY=change-me-in-production

# TTL токенов
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=7

# ===== Key Findings (TASK-018: только ENV, обязательны для production) =====
# Генерация: python scripts/generate_findings_keys.py --output ./secrets/
FINDINGS_ENCRYPTION_KEY=<base64 32 bytes>
FINDINGS_HMAC_KEY=<base64 32 bytes>
FINDINGS_KEY_ID=key-2026-09

# Secure-флаг HttpOnly cookie (BUG-042): true только за HTTPS
AUTH_COOKIE_SECURE=false

# ===== Active Directory (для hybrid/windows_integrated) =====
AD_DOMAIN=
AD_SERVER=
AD_SERVICE_USER=
AD_SERVICE_PASSWORD=

# ===== PostgreSQL =====
POSTGRES_DB=dcap
POSTGRES_USER=dcap
POSTGRES_PASSWORD=dcap123

# ===== Redis (Celery broker + кэш + rate-limit) =====
REDIS_PASSWORD=redis123
REDIS_ENABLED=true

# ===== Celery =====
CELERY_WORKER_QUEUES=audit_events,scanner_tasks,retention,reports

# ===== S3/MinIO аудит-агент (profile agents) =====
# Адрес MinIO с точки зрения контейнера агента. minio/minio в этом стенде
# запущен нативно на Windows (Docker-образ недоступен через прокси реестра),
# поэтому адрес — хост Docker Desktop, а не имя docker-сервиса.
# Если MinIO развёрнут в Docker (docker-compose.minio.yml) — используйте
# http://minio:9000. Реальный AWS S3: https://s3.amazonaws.com
S3_ENDPOINT=http://host.docker.internal:9000
S3_BUCKET=dcap-audit-logs
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_VERIFY_SSL=false
S3_PREFIX=access-logs/
S3_POLL_INTERVAL=15
MAX_ERROR_DELAY=60
# MinIO: dev-стенд (E:\Dev\MinIO), для production сменить.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# mTLS для s3-агента (пути внутри контейнера)
# MTLS_CERT_PATH=
# MTLS_KEY_PATH=
# MTLS_CA_PATH=

# ===== МОНИТОРИНГ (День 39) =====
# Grafana: http://localhost:3000 (admin / ${GRAFANA_PASSWORD})
GRAFANA_PASSWORD=admin
# Alertmanager (опционально: webhook/email/slack/telegram см. monitoring/alertmanager/alertmanager.yml)
ALERTMANAGER_ENABLED=true

# ===== SCANNER (НЕ в Docker, на хосте) =====
# Сканер запускается на хосте: python run_scanner.py scanner/config/scanner_config.json
# Он видит все пути хоста, поэтому НЕ требует монтирования в контейнер.
# MANAGER_URL (http://localhost:8000) задаётся в scanner/config/scanner_config.json

# ----- SCANNER: S3/MinIO (BACKLOG-097, v3.13.32) -----
# Секреты — только ENV (политика TASK-018). НЕ путать с секцией
# "S3/MinIO аудит-агент" выше — это разные процессы (аудит-агент и сканер).
# Endpoint/bucket/prefix/secure/use_path_style/region приходят в payload
# задачи от Manager (scan_config.connector.s3). Bucket задаётся в path
# S3-ресурса (POST /api/resources?type=s3&path=s3://bucket/prefix).
# Дефолтный endpoint (вариант B): если не задан в query ресурса и не выставлен
# этот ENV → 400. Один раз на Manager-хосте — и все S3-ресурсы по умолчанию
# указывают на него.
S3_DEFAULT_ENDPOINT=host.docker.internal:9000

# Секреты S3-СКАНЕРА (не S3-аудита!). Идентичны на всех инстансах сканера,
# которые работают с одним и тем же S3-сервером.
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# ===== mTLS (День 34) =====
MTLS_ENABLED=false
MTLS_STRICT=false
CERTS_DIR=certs

# ===== Логирование =====
LOG_LEVEL=INFO

# ===== HTTP (utf-8 для консоли Windows) =====
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# ===== BACKLOG-086 (v3.13.19): EMBEDDED OCR FRAGMENTS =====
# Scanner embeds OCR PNG fragments (<= MAX_FRAGMENT_EMBED_SIZE) into findings.
MAX_FRAGMENT_EMBED_SIZE=2097152
# Scanner batches results POST by size (20 MB default).
MAX_BATCH_SIZE_BYTES=20971520