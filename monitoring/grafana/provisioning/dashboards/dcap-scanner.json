{
  "uid": "dcap-scanner",
  "title": "DCAP Scanner",
  "tags": ["dcap", "scanner"],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Files scanned (total)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "exemplar": true, "expr": "sum(dcap_scanner_files_scanned_total)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Files per second",
      "gridPos": { "h": 8, "w": 12, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "exemplar": true, "expr": "sum by (scanner_id) (rate(dcap_scanner_files_scanned_total[5m]))", "legendFormat": "scanner {{ scanner_id }}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "files/s" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Findings rate by type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "exemplar": true, "expr": "sum by (type) (rate(dcap_scanner_findings_total[5m]))", "legendFormat": "{{ type }}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Per-file scan duration p50/p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "exemplar": true, "expr": "histogram_quantile(0.50, sum by (le) (rate(dcap_scanner_file_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "exemplar": true, "expr": "histogram_quantile(0.95, sum by (le) (rate(dcap_scanner_file_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "barGauge",
      "title": "Scan errors by type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "exemplar": true, "expr": "sum by (error_type) (rate(dcap_scanner_errors_total[5m]))", "legendFormat": "{{ error_type }}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 } ] } }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Current task id",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "exemplar": true, "expr": "dcap_scanner_current_task", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "OCR latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "exemplar": true, "expr": "histogram_quantile(0.95, sum by (le) (rate(dcap_scanner_ocr_duration_seconds_bucket[5m])))", "legendFormat": "ocr p95", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] }
}