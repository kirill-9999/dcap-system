{
    "server": {
        "host": "127.0.0.1",
        "port": 8000
    },
    "database": {
        "url": "sqlite:///manager/dcap.db"
    },
    "auth": {
        "mode": "hybrid",
        "jwt_secret_key": "change-me-in-production-32-chars-long",
        "jwt_access_ttl_minutes": 1440,
        "jwt_refresh_ttl_days": 7,
        "bcrypt_rounds": 12,
        "local_users_enabled": true,
        "auto_create_ad_users": true,
        "default_role": "viewer",
        "windows_auth": {
            "enabled": true,
            "ad_domain": "SAMDOM",
            "ad_server": "127.0.0.1",
            "ad_base_dn": "DC=samdom,DC=example,DC=com",
            "ad_ldap_port": 389,
            "ad_use_ssl": false,
            "service_account": "administrator",
            "service_password": "Passw0rd",
            "group_mapping": {
                "DCAP_Admins": "admin",
                "DCAP_Auditors": "auditor",
                "DCAP_Scanners": "scanner"
            }
        }
    },
    "webui": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 8001
    },
    "logging": {
        "level": "INFO"
    }
}
