# audit-agent-s3/.env.example

# S3/MinIO настройки
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=dcap-audit-logs
S3_PREFIX=access-logs/
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_POLL_INTERVAL=60
S3_MAX_FILES_PER_POLL=100
S3_VERIFY_SSL=true
S3_SOURCE_TYPE=s3

# Буфер
BUFFER_MAX_EVENTS=100000
BUFFER_CLEANUP_DAYS=7
BUFFER_COMMIT_BATCH=100

# Основной цикл
MAX_ERROR_DELAY=300

# Логирование (ротация)
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Имя агента (уникальное для каждого экземпляра)
S3_AGENT_NAME=s3-agent-1

# Manager URL
MANAGER_URL=http://localhost:8000

# Логирование
LOG_LEVEL=INFO
