{
    "agent": {
        "name": "${S3_AGENT_NAME:-s3-agent-1}",
        "version": "3.0.0",
        "source_type": "s3",
        "hostname": "${HOSTNAME:-localhost}"
    },
    "s3": {
        "endpoint": "${S3_ENDPOINT:-https://s3.amazonaws.com}",
        "bucket": "${S3_BUCKET}",
        "prefix": "${S3_PREFIX:-access-logs/}",
        "access_key": "${S3_ACCESS_KEY}",
        "secret_key": "${S3_SECRET_KEY}",
        "poll_interval": "${S3_POLL_INTERVAL:-60}",
        "max_files_per_poll": "${S3_MAX_FILES_PER_POLL:-100}",
        "verify_ssl": "${S3_VERIFY_SSL:-true}",
        "source_type": "${S3_SOURCE_TYPE:-s3}"
    },
    "manager": {
        "url": "${MANAGER_URL:-http://localhost:8000}",
        "timeout": "${MANAGER_TIMEOUT:-30}",
        "max_retries": "${MANAGER_MAX_RETRIES:-3}",
        "retry_delay": "${MANAGER_RETRY_DELAY:-5}",
        "cert_path": "${MTLS_CERT_PATH:-}",
        "key_path": "${MTLS_KEY_PATH:-}",
        "ca_path": "${MTLS_CA_PATH:-}"
    },
    "buffer": {
        "path": "data/buffer/buffer.db",
        "max_events": "${BUFFER_MAX_EVENTS:-100000}",
        "cleanup_days": "${BUFFER_CLEANUP_DAYS:-7}",
        "commit_batch": "${BUFFER_COMMIT_BATCH:-100}"
    },
    "heartbeat": {
        "interval": "${HEARTBEAT_INTERVAL:-30}"
    },
    "main": {
        "max_error_delay": "${MAX_ERROR_DELAY:-300}"
    },
    "logging": {
        "level": "${LOG_LEVEL:-INFO}",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "logs/s3_agent.log",
        "max_bytes": "${LOG_MAX_BYTES:-10485760}",
        "backup_count": "${LOG_BACKUP_COUNT:-5}"
    }
}
