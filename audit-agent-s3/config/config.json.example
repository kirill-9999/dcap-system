{
    "agent": {
        "name": "s3-agent-1",
        "version": "3.0.0",
        "source_type": "s3",
        "hostname": "localhost"
    },
    "s3": {
        "endpoint": "https://s3.amazonaws.com",
        "bucket": "my-audit-logs",
        "prefix": "access-logs/",
        "access_key": "YOUR_ACCESS_KEY",
        "secret_key": "YOUR_SECRET_KEY",
        "poll_interval": 60,
        "verify_ssl": true,
        "source_type": "s3"
    },
    "manager": {
        "url": "http://localhost:8000",
        "timeout": 30,
        "max_retries": 3,
        "retry_delay": 5
    },
    "buffer": {
        "path": "data/buffer/buffer.db",
        "max_events": 10000,
        "cleanup_days": 7
    },
    "heartbeat": {
        "interval": 30
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "logs/s3_agent.log"
    }
}
